---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cullis — A governance layer for autonomous AI agents in regulated industries" theme="light">

  <!-- Fixed page backdrop: cyan/indigo gradient blob that stays in viewport
       while the page scrolls. Sections with opaque backgrounds (gray-blue,
       dark navy) cover it like overlay tiles; transparent white sections
       reveal it underneath. Parallax-by-fix, not by scroll-listener. -->
  <div class="page-bg" aria-hidden="true"></div>

  <!-- 01 HERO -->
  <section class="hero">
    <div class="container narrow">
      <div class="hero-eyebrow reveal">
        Agent governance · pre-1.0 · self-hosted
      </div>

      <h1 class="hero-title reveal" data-delay="1">
        A governance layer for<br />
        autonomous AI agents<br />
        in regulated industries.
      </h1>

      <p class="hero-lead reveal" data-delay="2">
        Per-agent cryptographic identity. Policy enforced before the LLM
        call lands. Hash-chained audit your auditor can verify without
        trusting your IT team. Self-hosted, LLM-agnostic,
        <strong>FSL-1.1 + Apache-2.0</strong>.
      </p>

      <div class="hero-actions reveal" data-delay="3">
        <a href="#quickstart" class="btn btn-primary">Get the Mastio bundle</a>
        <a href="https://github.com/cullis-security/cullis" target="_blank" rel="noopener" class="btn btn-ghost">Read the code on GitHub</a>
      </div>
    </div>

    <div class="container hero-figure-wrap">
      <div class="hero-figure reveal" data-delay="4">
        <div class="screen-frame">
          <img src="/screenshots/mastio-overview.png" alt="Mastio overview dashboard, showing agent identity registry and live audit chain" loading="eager" />
        </div>
        <div class="screen-caption">Mastio control plane · one self-hosted container</div>
        <p class="screen-disclaimer">Illustrative screenshots from the Cullis demo stack. Agent identities, tool calls, and audit events shown are reproducible from the public repo, not a customer deployment.</p>
      </div>
    </div>
  </section>

  <!-- 02 STANDARDS ROW (trust signal in lieu of logo wall) -->
  <section class="standards">
    <div class="container">
      <p class="standards-label reveal">
        Built on standards. Auditable by inspection.
      </p>
      <ul class="standards-list reveal-stagger">
        <li>
          <span class="std-name">RFC 9449</span>
          <span class="std-where">DPoP</span>
        </li>
        <li>
          <span class="std-name">RFC 8705</span>
          <span class="std-where">mTLS client cert binding</span>
        </li>
        <li>
          <span class="std-name">RFC 3161</span>
          <span class="std-where">TSA anchoring (opt-in)</span>
        </li>
        <li>
          <span class="std-name">SPIFFE</span>
          <span class="std-where">Workload identity</span>
        </li>
        <li>
          <span class="std-name">EU AI Act</span>
          <span class="std-where">Art. 12 · Art. 14</span>
        </li>
        <li>
          <span class="std-name">DORA</span>
          <span class="std-where">Art. 9 · Art. 28</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- 03 MASTIO SHOWCASE — Stripe-style horizontal tab row + full-width screenshot
       Merges the old "What Cullis does" intro (kept the strong title) with the
       Mastio feature switcher. One section, no duplication. -->
  <section class="mastio-showcase" data-section-theme="dark" data-feature-grid>
    <div class="container">

      <div class="showcase-head">
        <p class="eyebrow reveal">Mastio · organisation control point</p>
        <h2 class="reveal" data-delay="1">
          Identity, authorization, audit.<br />
          For the agent, by the agent.
        </h2>
        <p class="showcase-lead reveal" data-delay="2">
          One self-hosted Docker container. Authority over agent identity,
          policy enforced before the LLM call lands, an append-only audit
          chain externally verifiable by your auditor or regulator. Works
          underneath any agent stack — Claude Agent SDK, OpenAI Agents SDK,
          LangGraph, CrewAI, or any MCP-aware loop.
        </p>
      </div>

      <div class="showcase-tabs reveal" data-delay="3">
        <button type="button" class="tab active" data-feature="pki">
          <span class="tab-num">01</span>
          <span class="tab-label">Cryptographic identity</span>
        </button>
        <button type="button" class="tab" data-feature="agents">
          <span class="tab-num">02</span>
          <span class="tab-label">Policy enforced pre-call</span>
        </button>
        <button type="button" class="tab" data-feature="audit">
          <span class="tab-num">03</span>
          <span class="tab-label">Tamper-evident audit chain</span>
        </button>
      </div>

      <div class="showcase-desc reveal" data-delay="4">
        <div data-feature-desc="pki" class="active">
          <p>
            x509 + SPIFFE ID per agent process. mTLS RFC 8705 and DPoP RFC
            9449. The caller authenticated at the gateway is the agent
            itself, not a shared service account. Rotation on its own
            schedule, revocation propagates in seconds. Designed around EU AI Act
            Art. 12 (record-keeping) and DORA Art. 9 (ICT protection —
            access and authentication management).
          </p>
          <a class="feature-link" href="https://github.com/cullis-security/cullis#cullis-mastio">Identity model →</a>
        </div>
        <div data-feature-desc="agents">
          <p>
            PDP fires before the LLM API or MCP tool runs. Per-principal
            scopes (this agent can read claim files, that agent cannot).
            OPA-compatible bundles or built-in DSL. Designed around EU AI Act
            Art. 14 (human oversight) and Art. 26 (deployer obligations on
            high-risk systems).
          </p>
          <a class="feature-link" href="https://github.com/cullis-security/cullis#cullis-mastio">Policy model →</a>
        </div>
        <div data-feature-desc="audit">
          <p>
            Every event (auth, enroll, message, tool call, LLM token)
            hashed and chained. Optional RFC 3161 TSA anchoring. Your
            auditor verifies the chain externally, without trusting
            Cullis or your IT team. Designed around EU AI Act Art. 12
            (record-keeping) + Art. 15 (accuracy, robustness,
            cybersecurity) and EIOPA Opinion BoS-25-360 (6 Aug 2025).
          </p>
          <a class="feature-link" href="https://github.com/cullis-security/cullis#cullis-mastio">Audit chain →</a>
        </div>
      </div>

      <div class="showcase-figure reveal" data-delay="5">
        <div class="screen-frame">
          <img src="/screenshots/mastio-pki.png" alt="Mastio PKI management" data-frame-img="pki" class="active" />
          <img src="/screenshots/mastio-agents.png" alt="Mastio policy management" data-frame-img="agents" />
          <img src="/screenshots/mastio-audit-log.png" alt="Mastio audit log" data-frame-img="audit" />
        </div>
        <p class="screen-disclaimer">Captured from the local Cullis demo stack. Reproducible from the public repo, not a customer deployment.</p>
      </div>

    </div>
  </section>

  <!-- 05 PAIN NARRATIVE / FROM THE REGULATION -->
  <section class="field-quote">
    <div class="container narrow">
      <p class="eyebrow reveal">Reading the regulation</p>
      <blockquote class="reveal" data-delay="1">
        <p>
          The pilots don't graduate. Not because the agent is wrong.
          Because no one in compliance can answer the only question
          the regulator will ask in 2027: <em>who decided what, with
          which input, eighteen months ago</em>, and how do we prove
          it without trusting the vendor.
        </p>
        <footer>
          Distilled from the EU regulated-AI literature — DORA Art. 28,
          EU AI Act Art. 12 + 14, EBA and EIOPA guidance.
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- 06 HOW IT FITS -->
  <section class="bridge-section">
    <div class="container narrow">
      <p class="eyebrow reveal">Drop-in integration · LLM-agnostic</p>
      <h2 class="reveal" data-delay="1">
        Wherever your agent lives.
      </h2>
      <p class="section-lead reveal" data-delay="2">
        Cullis sits underneath, not next to. Same governance primitives
        for Claude Agent SDK, OpenAI Agents SDK, LangGraph, CrewAI,
        Ollama on-prem. Switch model providers with one environment
        variable. Identity, policy, audit chain do not change.
      </p>

      <ul class="shapes reveal" data-delay="3">
        <li>
          <span class="shape-name">Cullis Mastio</span>
          <span class="shape-where">Organisation gateway · agent CA, policy enforcement, audit chain, MCP reverse proxy, embedded AI gateway · self-hosted container</span>
        </li>
        <li>
          <span class="shape-name">Cullis SDK</span>
          <span class="shape-where">Python client used by autonomous agents · mTLS + DPoP + chat_completion + MCP tool calls · backend services, in-process</span>
        </li>
        <li>
          <span class="shape-name">SPIRE / Kubernetes</span>
          <span class="shape-where">Kubernetes workloads · existing identity fabric</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- 06b DEPLOYMENT TOPOLOGY — two modes (embedded vs brownfield) -->
  <section class="topology-section">
    <div class="container">
      <div class="topology-head">
        <p class="eyebrow reveal">Mastio in your stack</p>
        <h2 class="reveal" data-delay="1">
          Three deployment modes.
        </h2>
        <p class="section-lead reveal" data-delay="2">
          Mastio is the AI gateway, sits in front of the one you already
          run, or stays out of the data path entirely. Identity, policy
          and audit chain are the same in all three.
        </p>
      </div>

      <div class="topology-grid reveal-stagger">
        <!-- Embedded mode -->
        <article class="topo-card">
          <span class="topo-num" aria-hidden="true">01</span>
          <header class="topo-card-head">
            <span class="topo-tag">Default</span>
            <h3>Embedded</h3>
            <p class="topo-sub">Mastio dispatches to the provider through a native adapter (official Anthropic / OpenAI SDKs, raw httpx for Ollama) — no third-party gateway in the critical path. One container, nothing extra to operate.</p>
          </header>
          <div class="topo-flow">
            <div class="topo-node">Agent</div>
            <div class="topo-edge" data-label="mTLS + DPoP"></div>
            <div class="topo-node topo-node-primary">
              <span class="topo-node-title">Mastio</span>
              <span class="topo-node-sub">Native AI dispatch</span>
            </div>
            <div class="topo-edge" data-label="API call"></div>
            <div class="topo-node">LLM provider</div>
          </div>
          <ul class="topo-bullets">
            <li>Greenfield deployments, banks without an existing AI gateway.</li>
            <li>Per-agent identity + audit chain end-to-end inside one boundary.</li>
            <li>Smallest moving-parts footprint for a pilot.</li>
          </ul>
        </article>

        <!-- Brownfield mode -->
        <article class="topo-card">
          <span class="topo-num" aria-hidden="true">02</span>
          <header class="topo-card-head">
            <span class="topo-tag">Brownfield</span>
            <h3>Behind an AI gateway</h3>
            <p class="topo-sub">You already run an AI gateway for cost control, fallback and caching. Mastio sits in front, the gateway stays in place.</p>
          </header>
          <div class="topo-flow">
            <div class="topo-node">Agent</div>
            <div class="topo-edge" data-label="mTLS + DPoP"></div>
            <div class="topo-node topo-node-primary">
              <span class="topo-node-title">Mastio</span>
              <span class="topo-node-sub">policy + audit</span>
            </div>
            <div class="topo-edge" data-label="HTTPS"></div>
            <div class="topo-node">AI gateway</div>
            <div class="topo-edge topo-edge-small"></div>
            <div class="topo-node">LLM provider</div>
          </div>
          <ul class="topo-bullets">
            <li>Existing AI gateway investment stays untouched.</li>
            <li>Mastio injects per-agent identity in the gateway request metadata. Gateway logs and Mastio audit chain correlate by trace id.</li>
            <li>Mastio's audit chain remains the canonical source of truth regardless of the gateway in front of the provider.</li>
          </ul>
        </article>

        <!-- Mode 3 — Control plane only (sidecar) -->
        <article class="topo-card">
          <span class="topo-num" aria-hidden="true">03</span>
          <header class="topo-card-head">
            <span class="topo-tag">Sidecar</span>
            <h3>Control plane only</h3>
            <p class="topo-sub">Mastio stays out of the LLM data path. The agent calls the provider directly. Identity, policy and audit live in Mastio over a side channel.</p>
          </header>
          <div class="topo-flow topo-flow-split">
            <div class="topo-plane-row">
              <span class="topo-plane-label">Data plane</span>
              <div class="topo-flow-row">
                <div class="topo-node">Agent</div>
                <div class="topo-edge" data-label="API call"></div>
                <div class="topo-node">LLM provider</div>
              </div>
            </div>
            <div class="topo-plane-row">
              <span class="topo-plane-label">Control plane</span>
              <div class="topo-flow-row">
                <div class="topo-node">Agent</div>
                <div class="topo-edge" data-label="mTLS + DPoP"></div>
                <div class="topo-node topo-node-primary">
                  <span class="topo-node-title">Mastio</span>
                  <span class="topo-node-sub">identity · policy · audit</span>
                </div>
              </div>
            </div>
          </div>
          <ul class="topo-bullets">
            <li>No latency added to the LLM call itself in this mode. The agent uses the provider's native SDK.</li>
            <li>Mastio attests identity, evaluates policy and receives audit events out-of-band.</li>
            <li>Best when latency budget is tight, or when the provider call must remain unchanged.</li>
          </ul>
        </article>
      </div>

      <div class="topology-footnote reveal" data-delay="4">
        <p class="topo-foot-label">Even behind a hardened enterprise gateway, three properties stay Cullis-only:</p>
        <ul class="topo-foot-list">
          <li><strong>Tamper-evident audit chain</strong><span>Hash-chained, externally verifiable end-to-end. Optional RFC 3161 TSA anchoring when a timestamp authority is configured.</span></li>
          <li><strong>Policy enforced before the call</strong><span>The PDP gates each request per-principal before the LLM or MCP tool runs. A gateway forwards; Mastio decides first.</span></li>
          <li><strong>Per-agent crypto identity</strong><span>x509 + SPIFFE + DPoP per agent. Gateways see the user; only Mastio attests the agent.</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 07 USE CASES — dark navy alternation, cards glow cyan on hover -->
  <section class="use-cases" data-section-theme="dark">
    <div class="container">
      <div class="use-cases-head">
        <p class="eyebrow reveal">Reference scenarios · regulated finance</p>
        <h2 class="reveal" data-delay="1">
          Four workflows regulated EU teams<br />
          are trying to graduate.
        </h2>
        <p class="section-lead reveal" data-delay="2">
          Two overlap with templates from Anthropic's
          <strong>Claude for Financial Services</strong> release. Two
          are Cullis-specific reference architectures. Stack
          heterogeneity (Claude in cloud, Ollama on-prem, MockLLM for
          deterministic replay) shows the governance layer is genuinely
          LLM-agnostic.
        </p>
      </div>

      <div class="use-case-grid reveal" data-delay="3">
        <article class="use-case-card">
          <div class="use-case-tag">Banking · KYC</div>
          <h3>KYC Screener</h3>
          <p>
            Entity file assembly + AML escalation on the Anthropic
            template. Per-agent cert binds every screening action.
            Designed around <strong>EU AI Act Art. 14 + Art. 12</strong>.</p>
        </article>

        <article class="use-case-card">
          <div class="use-case-tag">IB · Pitchbook</div>
          <h3>Pitchbook + Chinese Walls</h3>
          <p>
            Cross-desk capability gate blocks MNPI leakage —
            Industrials agent cannot read Tech docs. Designed around
            <strong>MAR Art. 16 + Art. 18</strong>.</p>
        </article>

        <article class="use-case-card">
          <div class="use-case-tag">Banking · DORA</div>
          <h3>DORA Vendor Reporter</h3>
          <p>
            Cullis-specific. Runs on <strong>open-weight LLM on-prem
            (Ollama)</strong> — no SaaS sees vendor risk data. Designed around
            <strong>DORA Art. 28 + Art. 30</strong>.</p>
        </article>

        <article class="use-case-card">
          <div class="use-case-tag">Capital Markets · Trading</div>
          <h3>Portfolio Rebalancer</h3>
          <p>
            Signal → reasoning → risk_check → place_order, every step
            hash-chained. PDP blocks orders when kill-switch on. Mock
            OMS — not production trading. Designed around <strong>MiFID II
            Art. 17 + RTS 6 Art. 23</strong> (pre-trade controls).
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- 08 QUICKSTART -->
  <section class="prose-section" id="quickstart">
    <div class="container narrow">
      <p class="eyebrow reveal">Quickstart</p>
      <h2 class="reveal" data-delay="1">
        Two artefacts. Pull, deploy, use.
      </h2>
      <p class="section-lead reveal" data-delay="2">
        The Mastio bundle is a self-contained tarball that pulls its
        image from <code>ghcr.io</code> and configures itself on first
        boot. The SDK is on PyPI.
      </p>

      <pre class="reveal" data-delay="3"><code># 1. Mastio — organisation gateway on :9443
curl -L https://github.com/cullis-security/cullis/releases/download/mastio-v0.7.0/cullis-mastio-bundle.tar.gz | tar xz
cd cullis-mastio-bundle &amp;&amp; ./deploy.sh</code></pre>

      <pre class="reveal" data-delay="4"><code># 2. Python SDK for your autonomous agent
pip install cullis-sdk</code></pre>

      <p class="reveal" data-delay="5">
        Mint an agent identity bundle from the Mastio dashboard, then
        wire it into the SDK. Six lines and the first
        <code>chat_completion</code> lands as an audit row.
      </p>

      <pre class="reveal" data-delay="6"><code>from cullis_sdk import CullisClient

client = CullisClient.from_identity_dir(
    "https://mastio.example.com:9443",
    cert_path="./identity/agent.crt",
    key_path="./identity/agent.key",
    dpop_key_path="./identity/dpop.jwk",
)

response = client.chat_completion(&#123;
    "model": "claude-sonnet-4-6",
    "messages": [&#123;"role": "user", "content": "Screen the latest applicant batch."&#125;],
&#125;)

for tool in client.list_mcp_tools():
    print(tool["name"])

result = client.call_mcp_tool("sanctions_lookup", &#123;"full_name": "Acme Holding Ltd"&#125;)</code></pre>

      <p class="reveal" data-delay="7">
        Full install instructions, enrolment paths, and production
        overrides on <a href="https://github.com/cullis-security/cullis">the repo</a>.
      </p>
    </div>
  </section>

  <!-- 09 CLOSING -->
  <section class="closing">
    <div class="container narrow">
      <p class="eyebrow reveal">Try the community release</p>
      <h2 class="reveal" data-delay="1">Read the code. Run the bundle. File an issue.</h2>
      <p class="section-lead reveal" data-delay="2">
        Cullis is alpha and open-core. The community release runs end-to-end on a Linux laptop in a few minutes. Feedback, bug reports, and PRs land in the public GitHub repo.
      </p>
      <div class="hero-actions reveal" data-delay="3">
        <a href="https://github.com/cullis-security/cullis" target="_blank" rel="noopener" class="btn btn-primary">GitHub</a>
        <a href="https://github.com/cullis-security/cullis/discussions" target="_blank" rel="noopener" class="btn btn-ghost">Discussions</a>
      </div>
    </div>
  </section>

  <script>
    const grid = document.querySelector('[data-feature-grid]');
    if (grid) {
      const items = grid.querySelectorAll<HTMLElement>('[data-feature]');
      const descs = grid.querySelectorAll<HTMLElement>('[data-feature-desc]');
      const imgs = grid.querySelectorAll<HTMLImageElement>('[data-frame-img]');
      const order = ['pki', 'agents', 'audit'];

      const activate = (key: string) => {
        items.forEach((i) => i.classList.toggle('active', i.dataset.feature === key));
        descs.forEach((d) => d.classList.toggle('active', d.dataset.featureDesc === key));
        imgs.forEach((img) => img.classList.toggle('active', img.dataset.frameImg === key));
      };

      // Auto-rotate until the visitor clicks a tab, then stop so they can read.
      let paused = false;
      items.forEach((item) => {
        item.addEventListener('click', () => {
          paused = true;
          activate(item.dataset.feature || '');
        });
      });

      let idx = 0;
      setInterval(() => {
        if (paused) return;
        idx = (idx + 1) % order.length;
        activate(order[idx]);
      }, 6000);
    }
  </script>
</Layout>

<style>
  /* ====================================================
     CONTAINER overrides
  ==================================================== */
  :global([data-theme="light"]) .container { max-width: 1180px; }

  /* ====================================================
     HERO (with animated ambient gradient — Stripe-style drift)
  ==================================================== */
  /* ====================================================
     PAGE BACKDROP — fixed gradient that stays in viewport while
     the page scrolls. Sections with opaque backgrounds (gray-blue,
     dark navy) cover it; transparent white sections reveal it.
     The blobs drift in place, never scroll with the document.
  ==================================================== */
  .page-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .page-bg::before {
    content: '';
    position: absolute;
    top: -10%;
    left: 50%;
    width: 1500px;
    height: 800px;
    max-width: 140vw;
    transform: translateX(-50%);
    background:
      radial-gradient(ellipse 42% 52% at 25% 35%, rgba(0, 229, 199, 0.32), transparent 62%),
      radial-gradient(ellipse 48% 48% at 75% 50%, rgba(99, 102, 241, 0.28), transparent 62%),
      radial-gradient(ellipse 38% 42% at 55% 22%, rgba(8, 145, 178, 0.26), transparent 65%),
      radial-gradient(ellipse 35% 35% at 80% 80%, rgba(0, 229, 199, 0.18), transparent 70%);
    animation: hero-drift 18s ease-in-out infinite;
    filter: blur(50px);
    opacity: 1;
  }

  .page-bg::after {
    content: '';
    position: absolute;
    bottom: -5%;
    left: 50%;
    width: 1100px;
    height: 380px;
    max-width: 120vw;
    transform: translateX(-50%);
    background:
      radial-gradient(ellipse 55% 60% at 50% 60%, rgba(0, 229, 199, 0.22), transparent 70%);
    filter: blur(70px);
    animation: hero-pulse 9s ease-in-out infinite;
  }

  /* Lift everything above the backdrop. Nav already has its own z-index. */
  :global(main) { position: relative; z-index: 1; }

  .hero {
    padding-top: clamp(5rem, 11vw, 8rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    text-align: center;
    position: relative;
  }

  .hero > * {
    position: relative;
    z-index: 1;
  }

  @keyframes hero-drift {
    0%, 100% {
      transform: translateX(-50%) translateY(0) scale(1) rotate(0deg);
    }
    25% {
      transform: translateX(-44%) translateY(-50px) scale(1.10) rotate(2deg);
    }
    50% {
      transform: translateX(-52%) translateY(40px) scale(0.94) rotate(-1deg);
    }
    75% {
      transform: translateX(-48%) translateY(-20px) scale(1.06) rotate(1deg);
    }
  }

  @keyframes hero-pulse {
    0%, 100% { opacity: 0.6; transform: translateX(-50%) scale(1); }
    50% { opacity: 1; transform: translateX(-50%) scale(1.15); }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-bg::before, .page-bg::after { animation: none; }
    .topo-edge { animation: none; }
    .hero-title.reveal { filter: none; transform: none; }
  }

  /* Subtle cyan halo on the primary CTA — brand spark sul bottone navy */
  :global(html[data-theme="light"]) .hero .btn-primary {
    box-shadow: 0 0 0 1px rgba(0, 229, 199, 0.0), 0 4px 14px rgba(10, 37, 64, 0.18);
    transition: box-shadow 0.3s ease, background 0.25s, transform 0.2s;
  }

  :global(html[data-theme="light"]) .hero .btn-primary:hover {
    box-shadow:
      0 0 0 3px rgba(0, 229, 199, 0.18),
      0 8px 24px rgba(10, 37, 64, 0.22),
      0 0 32px rgba(0, 229, 199, 0.20);
    transform: translateY(-1px);
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 2.5rem;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, 4.4rem);
    line-height: 1.08;
    margin: 0 auto;
    font-weight: 700;
    letter-spacing: -0.025em;
    max-width: 22ch;
    color: var(--text-primary);
  }

  /* Cinematic blur-rise on the headline (upgrades the flat .reveal fade) */
  .hero-title.reveal {
    transform: translateY(28px) scale(0.992);
    filter: blur(10px);
    transition: opacity 1s cubic-bezier(0.16, 1, 0.3, 1),
                transform 1s cubic-bezier(0.16, 1, 0.3, 1),
                filter 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-title.reveal.visible {
    transform: translateY(0) scale(1);
    filter: blur(0);
  }

  .hero-lead {
    font-size: clamp(1.05rem, 1.3vw, 1.18rem);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 56ch;
    margin: 1.8rem auto 2.4rem auto;
  }

  .hero-lead strong { color: var(--text-primary); font-weight: 600; }

  .hero-actions {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 0;
  }

  .hero-figure-wrap {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .hero-figure {
    max-width: 1080px;
    margin: 0 auto;
  }

  .screen-frame {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border-medium);
    border-radius: 10px;
    overflow: hidden;
    box-shadow:
      0 1px 0 rgba(15, 20, 25, 0.06),
      0 30px 60px rgba(15, 20, 25, 0.10),
      0 6px 14px rgba(15, 20, 25, 0.05),
      0 0 0 1px rgba(0, 229, 199, 0.04),
      0 20px 80px rgba(0, 229, 199, 0.08);
  }

  .screen-frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .screen-caption {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    text-align: center;
    margin-top: 1.4rem;
  }

  .screen-disclaimer {
    font-family: var(--font-body);
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--text-tertiary);
    text-align: center;
    margin: 0.75rem auto 0;
    max-width: 58ch;
    font-style: italic;
    opacity: 0.85;
  }

  /* ====================================================
     STANDARDS ROW
  ==================================================== */
  .standards {
    padding: clamp(2.5rem, 5vw, 4rem) 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    background: #F6F9FC;
  }

  .standards-label {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 2rem;
  }

  .standards-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1.5rem;
    text-align: center;
  }

  .standards-list li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.6rem 0.4rem;
    border-radius: 10px;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
                background 0.25s ease;
  }

  .standards-list li:hover {
    transform: translateY(-4px);
    background: var(--accent-cyan-dim, rgba(8, 145, 178, 0.08));
  }

  .standards-list li:hover .std-name { color: var(--accent-cyan); }

  .std-name {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    transition: color 0.25s ease;
  }

  .std-where {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  /* ====================================================
     PROSE SECTION (What Cullis does, Quickstart, Closing)
  ==================================================== */
  .prose-section {
    padding: clamp(4rem, 9vw, 7rem) 0;
  }

  .prose-section h2,
  .feature-head h2,
  .bridge-section h2,
  .use-cases-head h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin: 1rem 0 1.5rem 0;
    font-weight: 700;
  }

  .section-lead {
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 62ch;
    margin: 0 0 2.5rem 0;
  }

  /* ====================================================
     MASTIO SHOWCASE — Stripe-style horizontal tab row + full-width screenshot.
     Continuous underline below the tabs, cyan accent slides under the active tab.
     Description block cross-fades below tabs. Screenshot under all of it.
  ==================================================== */
  .mastio-showcase {
    padding: clamp(5rem, 10vw, 8rem) 0;
    position: relative;
    overflow: hidden;
  }

  .mastio-showcase[data-section-theme="dark"]::before {
    content: '';
    position: absolute;
    top: 15%;
    right: -10%;
    width: 80%;
    height: 85%;
    background:
      radial-gradient(ellipse 60% 50% at 60% 50%, rgba(0, 229, 199, 0.14), transparent 65%),
      radial-gradient(ellipse 50% 45% at 35% 70%, rgba(0, 184, 169, 0.09), transparent 70%),
      radial-gradient(ellipse 45% 40% at 75% 25%, rgba(0, 229, 199, 0.08), transparent 65%);
    pointer-events: none;
    z-index: 0;
    filter: blur(70px);
    animation: mastio-drift 22s ease-in-out infinite;
  }

  .mastio-showcase .container {
    position: relative;
    z-index: 1;
  }

  @keyframes mastio-drift {
    0%, 100% { transform: translateX(0) translateY(0) scale(1); }
    50% { transform: translateX(-30px) translateY(20px) scale(1.05); }
  }

  /* Frame extends the Mastio dashboard's cyan signature into the section */
  :global([data-section-theme="dark"]) .screen-frame {
    border: 1px solid rgba(0, 229, 199, 0.12);
    border-radius: 10px;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 30px 80px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(0, 229, 199, 0.06),
      0 0 60px rgba(0, 229, 199, 0.12),
      0 0 120px rgba(0, 229, 199, 0.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .mastio-showcase[data-section-theme="dark"]::before { animation: none; }
  }

  /* HEAD centered above the tab row */
  .showcase-head {
    max-width: 820px;
    margin: 0 auto clamp(2.5rem, 5vw, 4rem) auto;
    text-align: center;
  }

  .showcase-head .eyebrow {
    justify-content: center;
  }

  .showcase-lead {
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 62ch;
    margin: 0 auto;
  }

  /* TAB ROW — horizontal, 3 columns, continuous underline */
  .showcase-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
    margin-bottom: 2.5rem;
  }

  .tab {
    appearance: none;
    background: transparent;
    border: none;
    padding: 1.4rem 1.2rem;
    cursor: pointer;
    text-align: left;
    position: relative;
    color: rgba(236, 239, 244, 0.45);
    transition: color 0.3s ease;
    font-family: inherit;
  }

  .tab:hover { color: rgba(236, 239, 244, 0.85); }
  .tab.active { color: var(--dark-text); }

  /* Cyan slider underneath active tab — Stripe-style */
  .tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--dark-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 0 12px rgba(0, 229, 199, 0.55);
  }

  .tab.active::after { transform: scaleX(1); }

  .tab-num {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    color: rgba(173, 189, 204, 0.65);
    transition: color 0.3s;
  }

  .tab.active .tab-num { color: var(--dark-accent); }

  .tab-label {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  /* DESCRIPTION block — cross-fades when active tab changes */
  .showcase-desc {
    position: relative;
    max-width: 64ch;
    margin: 0 0 clamp(2.5rem, 5vw, 3.5rem) 0;
    min-height: 11rem;
  }

  .showcase-desc > div {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .showcase-desc > div.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .showcase-desc p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin: 0 0 1rem 0;
    max-width: none;
  }

  .feature-link {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: var(--dark-accent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .feature-link:hover { border-bottom-color: var(--dark-accent); }

  /* SCREENSHOT FIGURE — full-width below the description */
  .showcase-figure {
    margin-top: 1.5rem;
  }

  .showcase-figure .screen-frame {
    aspect-ratio: 1618 / 863;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
  }

  .showcase-figure .screen-frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .showcase-figure .screen-frame img.active { opacity: 1; }

  /* ====================================================
     FIELD QUOTE
  ==================================================== */
  .field-quote {
    padding: clamp(4rem, 9vw, 7rem) 0;
    background: #F6F9FC;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .field-quote blockquote {
    margin: 1.5rem 0 0 0;
    padding: 0;
    border: none;
  }

  .field-quote blockquote p {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    line-height: 1.35;
    color: var(--text-primary);
    margin: 0 0 1.5rem 0;
    max-width: none;
  }

  .field-quote blockquote em {
    font-style: italic;
    color: var(--text-primary);
  }

  .field-quote blockquote footer {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--text-tertiary);
    max-width: 56ch;
  }

  /* ====================================================
     BRIDGE / HOW IT FITS
  ==================================================== */
  .bridge-section {
    padding: clamp(4rem, 9vw, 7rem) 0;
    border-top: 1px solid var(--border-subtle);
  }

  .shapes {
    list-style: none;
    margin: 2rem 0 0 0;
    padding: 0;
    border-top: 1px solid var(--border-subtle);
  }

  .shapes li {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) 3fr;
    gap: 2rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--border-subtle);
    align-items: baseline;
  }

  .shape-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .shape-where {
    font-family: var(--font-body);
    font-size: 0.96rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* ====================================================
     DEPLOYMENT TOPOLOGY — two modes (embedded / brownfield).
     Stripe-style cool-gray band between the white How-it-fits
     and the dark Use-cases. Mini flow diagrams in pure HTML+CSS
     so we don't ship the 30KB d2-rendered SVG.
  ==================================================== */
  .topology-section {
    padding: clamp(4rem, 9vw, 7rem) 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(0, 229, 199, 0.04) 0%, transparent 60%),
      linear-gradient(180deg, #EDF2F7 0%, #E4ECF5 100%);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    position: relative;
    overflow: hidden;
  }

  /* Subtle dot grid pattern for texture (Stripe-style) */
  .topology-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(10, 37, 64, 0.07) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: 0 0;
    opacity: 0.5;
    pointer-events: none;
    z-index: 0;
  }

  .topology-section > .container { position: relative; z-index: 1; }

  .topology-head {
    max-width: 56ch;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .topology-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 2.5vw, 2rem);
    max-width: 860px;
    margin: 0 auto;
  }

  .topo-card {
    position: relative;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--accent-cyan, #0891B2);
    border-radius: 12px;
    padding: clamp(1.8rem, 3vw, 2.4rem) clamp(1.8rem, 3vw, 2.4rem) clamp(1.8rem, 3vw, 2.4rem) clamp(4.5rem, 7vw, 5.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    box-shadow:
      0 1px 2px rgba(10, 37, 64, 0.06),
      0 10px 30px -12px rgba(10, 37, 64, 0.12);
    transition: box-shadow 200ms ease, transform 200ms ease;
  }

  .topo-card:hover {
    box-shadow:
      0 1px 2px rgba(10, 37, 64, 0.06),
      0 20px 40px -12px rgba(10, 37, 64, 0.18),
      0 0 0 1px rgba(0, 229, 199, 0.15);
  }

  .topo-num {
    position: absolute;
    top: clamp(1.3rem, 2.4vw, 1.8rem);
    left: clamp(1.4rem, 2.4vw, 1.9rem);
    font-family: var(--font-mono);
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    font-weight: 700;
    color: var(--accent-cyan, #0891B2);
    letter-spacing: 0.06em;
    line-height: 1;
    user-select: none;
  }

  .topo-card-head h3 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2vw, 1.7rem);
    font-weight: 700;
    color: var(--text-primary);
    margin: 0.4rem 0 0.6rem 0;
    line-height: 1.15;
  }

  .topo-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-cyan, #0891B2);
    background: rgba(8, 145, 178, 0.08);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid rgba(8, 145, 178, 0.18);
  }

  .topo-sub {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Flow diagram: row of nodes + edges, wraps on narrow */
  .topo-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0;
    padding: 1.2rem 0;
    border-top: 1px dashed var(--border-subtle);
    border-bottom: 1px dashed var(--border-subtle);
  }

  .topo-node {
    flex: 0 0 auto;
    background: #FFFFFF;
    border: 1px solid #D9E2EC;
    border-radius: 8px;
    padding: 0.55rem 0.7rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    line-height: 1.25;
    min-width: 78px;
    align-self: center;
  }

  .topo-node-title {
    font-weight: 700;
    color: var(--text-primary);
  }

  .topo-node-sub {
    display: block;
    font-size: 0.7rem;
    color: var(--text-tertiary, #627D98);
    margin-top: 0.18rem;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }

  .topo-node-primary {
    background: linear-gradient(180deg, #0A2540 0%, #102E4F 100%);
    border-color: #0A2540;
    color: #FFFFFF;
  }
  .topo-node-primary .topo-node-title { color: #FFFFFF; }
  .topo-node-primary .topo-node-sub { color: rgba(255, 255, 255, 0.7); }

  .topo-edge {
    flex: 1 1 24px;
    min-width: 24px;
    height: 2px;
    border-radius: 2px;
    /* Layer 1: a bright cyan packet that travels the wire (Agent → Mastio → provider).
       Layer 2: the static base wire. */
    background-image:
      linear-gradient(90deg, rgba(0, 229, 199, 0) 0%, rgba(0, 229, 199, 1) 50%, rgba(0, 229, 199, 0) 100%),
      linear-gradient(90deg, rgba(8, 145, 178, 0.30) 0%, rgba(8, 145, 178, 0.65) 50%, rgba(8, 145, 178, 0.30) 100%);
    background-repeat: no-repeat, no-repeat;
    background-size: 40px 100%, 100% 100%;
    background-position: -40px center, center;
    align-self: center;
    position: relative;
    margin: 0 0.25rem;
    /* packet travels + the whole wire blooms in sync */
    animation: topo-flow 1.9s linear infinite, topo-glow 1.9s ease-in-out infinite;
  }

  @keyframes topo-flow {
    to { background-position: calc(100% + 40px) center, center; }
  }

  @keyframes topo-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(0, 229, 199, 0); }
    50% { box-shadow: 0 0 9px 1px rgba(0, 229, 199, 0.55); }
  }

  .topo-edge::after {
    content: "";
    position: absolute;
    right: -1px;
    top: 50%;
    width: 0;
    height: 0;
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    border-left: 6px solid var(--accent-cyan, #0891B2);
    transform: translateY(-50%);
  }

  .topo-edge[data-label]::before {
    content: attr(data-label);
    position: absolute;
    bottom: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--text-tertiary, #627D98);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .topo-edge-small { flex-basis: 22px; min-width: 22px; }

  /* Split flow for the sidecar mode: stack data-plane + control-plane rows */
  .topo-flow-split {
    flex-direction: column;
    gap: 1rem;
    padding: 1.3rem 0;
  }

  .topo-plane-row {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1rem;
    align-items: center;
  }

  .topo-plane-label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary, #627D98);
    text-align: right;
    padding-right: 0.4rem;
    border-right: 1px solid var(--border-subtle);
  }

  .topo-flow-row {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
  }

  .topo-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .topo-bullets li {
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-secondary);
    position: relative;
    padding-left: 1.2rem;
  }

  .topo-bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent-cyan, #0891B2);
  }

  .topo-bullets code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    background: rgba(10, 37, 64, 0.06);
    padding: 0.1em 0.35em;
    border-radius: 4px;
    color: var(--text-primary);
  }

  /* Footnote: three Cullis-only properties */
  .topology-footnote {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
    padding: 1.6rem 1.8rem;
    background: #FFFFFF;
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
  }

  .topo-foot-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-tertiary, #627D98);
    margin: 0 0 1rem 0;
  }

  .topo-foot-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

